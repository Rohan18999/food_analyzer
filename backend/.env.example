NODE_ENV=development
PORT=3002

# MongoDB Atlas (optional — RAG retrieval disabled if not set)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/food_health_analyzer

# Groq (required for AI explanations — deterministic score works without it, using fallback)
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk-your-key-here
# Verified working 2026-09: Groq vision supports qwen/qwen3.6-27b (and qwen3.8); llama vision retired
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# RAG settings
RAG_TOP_K=5
KNOWLEDGE_DIR=./knowledge

# Upload settings
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads
